# Copia in .env e compila. Il file .env è escluso da git.

# --- Broker -------------------------------------------------------------
# sim = broker simulato locale (prove); ibkr = Interactive Brokers via IB Gateway
TRADER_BROKER=sim
TRADER_SIM_INITIAL_CASH=1000
# IB Gateway: paper 4002, live 4001 (TWS: paper 7497, live 7496)
TRADER_IBKR_HOST=127.0.0.1
TRADER_IBKR_PORT=4002
TRADER_IBKR_CLIENT_ID=17
TRADER_IBKR_ACCOUNT=
# 1 = dati in tempo reale (abbonamento), 3 = ritardati
TRADER_IBKR_MARKET_DATA_TYPE=1

# --- Approvazione -------------------------------------------------------
# manual = ogni entrata richiede approvazione umana (fase 4)
TRADER_APPROVAL_MODE=manual
# Per auto servono entrambi: TRADER_APPROVAL_MODE=auto e TRADER_ALLOW_AUTO_EXECUTION=true
TRADER_ALLOW_AUTO_EXECUTION=false

# --- Telegram (facoltativo) ---------------------------------------------
# Crea il bot con @BotFather; chat_id = il tuo id utente (scrivi al bot e usa getUpdates)
TRADER_TELEGRAM_BOT_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

# --- SEC EDGAR ----------------------------------------------------------
# Obbligatorio per scaricare i filing: nome e contatto, es. "Nome Cognome nome@dominio.it"
TRADER_SEC_USER_AGENT=

# --- LLM (facoltativo) --------------------------------------------------
TRADER_LLM_ENABLED=false
TRADER_LLM_TRIAGE_MODEL=claude-haiku-5-5
TRADER_LLM_ANALYSIS_MODEL=claude-opus-5-5
TRADER_LLM_ANALYSIS_EFFORT=high
ANTHROPIC_API_KEY=

# --- Database -----------------------------------------------------------
# Default: SQLite in var/trader.sqlite. Qualsiasi URL SQLAlchemy (es. Postgres) funziona.
# TRADER_DB_URL=sqlite:///var/trader.sqlite
